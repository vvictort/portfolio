---
import MainLayout from "../layouts/MainLayout.astro";
import { Navigation } from "../components/layout/Navigation";
import { PhotoGallery } from "../components/ui/PhotoGallery";
import { Plane, ChevronLeft, MapPin } from "lucide-react";
import photographyData from "../data/photography.json";

const photos = photographyData.outdoor;
const totalCaptures = photos.reduce((total, photo) => total + photo.images.length, 0);
---

<MainLayout title="Flight Log: Outdoor | Victor Thai">
    <Navigation client:load />

    <main class="w-full bg-airport-grid min-h-screen pt-32 pb-20 px-5 sm:px-8 relative overflow-hidden">
        {/* Background Atmosphere */}
        <div class="fixed inset-0 bg-[#050505] -z-10"></div>
        <div
            class="fixed top-0 right-0 w-[500px] h-[500px] bg-primary/5 rounded-full blur-[120px] -z-10 translate-x-1/2 -translate-y-1/2">
        </div>

        <div class="max-w-6xl mx-auto flex flex-col gap-12 relative z-10">
            {/* Header / Nav Header */}
            <div class="flex flex-col gap-8">
                <a
                    href="/"
                    class="flex items-center gap-2 text-zinc-500 hover:text-primary transition-colors group w-fit">
                    <ChevronLeft className="w-4 h-4 transition-transform group-hover:-translate-x-1" />
                    <span class="font-mono text-xs tracking-widest uppercase">Return to Main Dash</span>
                </a>

                <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-white/10">
                    <div class="flex flex-col gap-2 max-w-[34rem] pr-2 sm:pr-4 md:pr-0">
                        <div class="flex items-center gap-3 pr-1 sm:pr-0">
                            <div class="w-2 h-2 rounded-full bg-primary animate-pulse"></div>
                            <span class="text-primary font-mono text-xs sm:text-sm font-bold tracking-[0.28em] sm:tracking-[0.4em] uppercase"
                                >Log Category: 04-A</span
                            >
                        </div>
                        <h1 class="max-w-[12ch] md:max-w-none text-[clamp(3.15rem,14vw,4.5rem)] md:text-6xl leading-[0.88] font-bold tracking-tight text-white uppercase italic">
                            Outdoor <span class="text-zinc-600">Expeditions</span>
                        </h1>
                        <p class="text-zinc-400 font-mono text-sm max-w-[34ch] sm:max-w-xl mt-4 leading-relaxed pr-2 sm:pr-0">
                            A visual record of high-altitude excursions, urban mapping, and environmental exploration
                            beyond the digital frontier.
                        </p>
                    </div>

                    <div
                        class="w-full md:w-auto flex flex-col gap-3 bg-white/5 border border-white/10 p-4 rounded-xl backdrop-blur-md self-stretch md:self-auto">
                        <div class="flex items-start justify-between gap-3 sm:items-center">
                            <span class="text-[9px] font-mono text-zinc-500 tracking-[0.3em] uppercase text-left"
                                >Operational Status</span
                            >
                            <div
                                class="flex h-7 shrink-0 items-center justify-center px-2.5 bg-green-500/20 border border-green-500/30 rounded-sm">
                                <span class="text-[9px] leading-none whitespace-nowrap font-mono text-green-500 font-bold uppercase"
                                    >Ready for Boarding</span
                                >
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-3 w-full">
                            <div class="min-w-0 rounded-lg border border-white/5 bg-white/[0.02] px-3 py-2 flex flex-col text-left">
                                <span class="text-[8px] font-mono text-zinc-500 uppercase">Sector</span>
                                <span class="text-[11px] leading-tight md:text-xs font-mono text-white font-bold uppercase">NORTH // WEST</span>
                            </div>
                            <div class="min-w-0 rounded-lg border border-white/5 bg-white/[0.02] px-3 py-2 flex flex-col text-left">
                                <span class="text-[8px] font-mono text-zinc-500 uppercase">Records</span>
                                <span class="text-[11px] leading-tight md:text-xs font-mono text-white font-bold uppercase"
                                    >{totalCaptures} Units</span
                                >
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {/* Gallery Grid */}
            <PhotoGallery client:load photos={photos} type="outdoor" />

            {/* Bottom Technical Overlay */}
            <div
                class="mt-20 pt-12 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-6 md:gap-8 text-center md:text-left opacity-40 grayscale group hover:grayscale-0 hover:opacity-100 transition-all duration-700">
                <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6 max-w-full">
                    <Plane className="w-8 h-8 text-zinc-600 rotate-45" />
                    <div class="flex flex-col items-center md:items-start min-w-0">
                        <span class="font-mono text-[10px] text-white font-bold tracking-widest"
                            >FLIGHT LOG GENERATED</span
                        >
                        <span class="font-mono text-[8px] text-zinc-500"
                            >SYSTEM TIMESTAMP: <span class="break-all">{new Date().toISOString()}</span></span
                        >
                    </div>
                </div>
                <div class="flex flex-wrap justify-center md:justify-end gap-x-4 gap-y-2 max-w-full font-mono text-[8px] text-zinc-500 tracking-[0.24em] md:tracking-[0.4em]">
                    <span>DATA_SECURE</span>
                    <span class="hidden md:inline">//</span>
                    <span>ENCRYPTION_ACTIVE</span>
                    <span class="hidden md:inline">//</span>
                    <span>AUTH_VT</span>
                </div>
            </div>
        </div>
    </main>
</MainLayout>
