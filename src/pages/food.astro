---
import MainLayout from '../layouts/MainLayout.astro';
import { Navigation } from '../components/layout/Navigation';
import { PhotoGallery } from '../components/ui/PhotoGallery';
import { Plane, ChevronLeft, Utensils } from 'lucide-react';
import photographyData from '../data/photography.json';

const photos = photographyData.food;
const totalCaptures = photos.reduce((total, photo) => total + photo.images.length, 0);
---

<MainLayout title="Flight Log: Food | Victor Thai">
    <Navigation client:load />
    
    <main class="w-full bg-airport-grid min-h-screen pt-32 pb-20 px-8 relative overflow-hidden">
        {/* Background Atmosphere */}
        <div class="fixed inset-0 bg-[#050505] -z-10" />
        <div class="fixed top-0 left-0 w-[500px] h-[500px] bg-primary/5 rounded-full blur-[120px] -z-10 -translate-x-1/2 -translate-y-1/2" />
        
        <div class="max-w-6xl mx-auto flex flex-col gap-12 relative z-10">
            {/* Header / Nav Header */}
            <div class="flex flex-col gap-8">
                <a href="/" class="flex items-center gap-2 text-zinc-500 hover:text-primary transition-colors group w-fit">
                    <ChevronLeft className="w-4 h-4 transition-transform group-hover:-translate-x-1" />
                    <span class="font-mono text-xs tracking-widest uppercase">Return to Main Dash</span>
                </a>

                <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-white/10">
                    <div class="flex flex-col gap-2">
                        <div class="flex items-center gap-3">
                            <div class="w-2 h-2 rounded-full bg-primary animate-pulse" />
                            <span class="text-primary font-mono text-sm font-bold tracking-[0.4em] uppercase">In-Flight Service: 04-B</span>
                        </div>
                        <h1 class="text-5xl md:text-6xl font-bold tracking-tight text-white uppercase italic">
                            Local <span class="text-zinc-600">Flavors</span>
                        </h1>
                        <p class="text-zinc-400 font-mono text-sm max-w-xl mt-4 leading-relaxed">
                            A culinary log documenting gastronomic discoveries, local flavors, and the best "In-Flight" meals across various city sectors.
                        </p>
                    </div>

                    <div class="flex flex-col items-end gap-3 bg-white/5 border border-white/10 p-4 rounded-xl backdrop-blur-md">
                        <div class="flex items-center gap-2">
                            <span class="flex flex-col text-[9px] leading-[1.35] font-mono text-zinc-500 tracking-[0.3em] uppercase">
                                <span>Menu</span>
                                <span>Status</span>
                            </span>
                            <div class="flex h-7 items-center justify-center px-2 bg-green-500/20 border border-green-500/30 rounded-sm">
                                <span class="text-[9px] leading-none font-mono text-green-500 font-bold uppercase">Ready for Tasting</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-8">
                            <div class="flex flex-col items-end">
                                <span class="text-[8px] font-mono text-zinc-500 uppercase">Sector</span>
                                <span class="text-xs font-mono text-white font-bold uppercase">CULINARY // HUB</span>
                            </div>
                            <div class="flex flex-col items-end">
                                <span class="text-[8px] font-mono text-zinc-500 uppercase">Entries</span>
                                <span class="text-xs font-mono text-white font-bold uppercase">{totalCaptures} Units</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {/* Gallery Grid */}
            <PhotoGallery client:load photos={photos} type="food" />

            {/* Bottom Technical Overlay */}
            <div class="mt-20 pt-12 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-8 opacity-40 grayscale group hover:grayscale-0 hover:opacity-100 transition-all duration-700">
                <div class="flex items-center gap-6">
                    <Utensils className="w-8 h-8 text-zinc-600" />
                    <div class="flex flex-col">
                        <span class="font-mono text-[10px] text-white font-bold tracking-widest">MENU LOG GENERATED</span>
                        <span class="font-mono text-[8px] text-zinc-500">SYSTEM TIMESTAMP: {new Date().toISOString()}</span>
                    </div>
                </div>
                <div class="flex gap-4 font-mono text-[8px] text-zinc-500 tracking-[0.4em]">
                    <span>QUALITY_CERTIFIED</span>
                    <span>//</span>
                    <span>FLAVOR_VERIFIED</span>
                    <span>//</span>
                    <span>AUTH_VT</span>
                </div>
            </div>
        </div>
    </main>
</MainLayout>
