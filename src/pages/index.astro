---
import MainLayout from '../layouts/MainLayout.astro';
import { FlightBoard } from '../components/ui/FlightBoard';
import { Navigation } from '../components/layout/Navigation';
import { AboutSection } from '../components/sections/AboutSection';
import { JourneySection } from '../components/sections/JourneySection';
import { DestinationsSection } from '../components/sections/DestinationsSection';
import { BeyondCodeSection } from '../components/sections/BeyondCodeSection';
import { ArrivalsSection } from '../components/sections/ArrivalsSection';
import { SmoothScroll } from '../components/layout/SmoothScroll';
import { BackgroundCosmetics } from '../components/ui/BackgroundCosmetics';
import { HeroStars } from '../components/ui/HeroStars';

import projects from '../data/projects.json';
---

<MainLayout title="Victor Thai | Portfolio">
	<SmoothScroll client:load>
		<BackgroundCosmetics client:load />
		<Navigation client:load />

		<main class="w-full bg-airport-grid relative z-10">
			{/* Departures Section */}
			<section id="departures" class="min-h-screen w-full relative flex text-white flex-col items-center justify-center overflow-hidden">
			<HeroStars client:load />
			<div class="w-full max-w-6xl mx-auto px-8 relative z-10">
                <FlightBoard client:idle />
            </div>
            <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-zinc-500 font-mono text-sm animate-pulse pointer-events-none">
                <span class="tracking-widest">SCROLL TO BOARD</span>
                <span class="text-xl">⌄</span>
            </div>
            </div>
		</section>

		{/* A1: About Section */}
		<section id="about" class="min-h-screen w-full relative flex items-center justify-center py-20">
			<AboutSection client:visible />
		</section>

        {/* B2: Journey Section */}
		<section id="journey" class="min-h-screen w-full relative flex items-center justify-center py-20">
			<JourneySection client:visible />
		</section>

        {/* C3: Destinations Section */}
		<section id="destinations" class="min-h-screen w-full relative flex items-center justify-center py-20">
			<DestinationsSection client:visible projects={projects} />
		</section>

        {/* D4: Beyond Code Section */}
		<section id="beyond-code" class="min-h-screen w-full relative flex items-center justify-center py-20">
			<BeyondCodeSection client:visible />
		</section>

        {/* E5: Arrivals Section */}
		<section id="arrivals" class="min-h-screen w-full relative flex items-center justify-center">
			<ArrivalsSection client:visible />
		</section>
		</main>
	</SmoothScroll>
</MainLayout>
<style>
	html.lenis, html.lenis body {
		height: auto;
	}
	.lenis.lenis-smooth {
		scroll-behavior: auto !important;
	}
	.lenis.lenis-smooth [data-lenis-prevent] {
		overscroll-behavior: contain;
	}
	.lenis.lenis-stopped {
		overflow: hidden;
	}
	.lenis.lenis-smooth iframe {
		pointer-events: none;
	}
</style>
