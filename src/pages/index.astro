---
import MainLayout from '../layouts/MainLayout.astro';
import { FlightBoard } from '../components/ui/FlightBoard';
import { Navigation } from '../components/layout/Navigation';
import { AboutSection } from '../components/sections/AboutSection';
import { JourneySection } from '../components/sections/JourneySection';
import { DestinationsSection } from '../components/sections/DestinationsSection';
import { BeyondCodeSection } from '../components/sections/BeyondCodeSection';
import { ContactSection } from '../components/sections/ContactSection';
import { ArrivalsSection } from '../components/sections/ArrivalsSection';
import { BackgroundCosmetics } from '../components/ui/BackgroundCosmetics';
import { HeroStars } from '../components/ui/HeroStars';
import { ScrollToStartButton } from '../components/ui/ScrollToStartButton';

import projectsData from '../data/projects.json';
const projects = [...projectsData].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<MainLayout title="Victor Thai | Portfolio">
		<BackgroundCosmetics client:load />
		<Navigation client:load />

		<main class="w-full bg-airport-grid relative z-10">
			{/* Departures Section */}
			<section id="departures" class="min-h-screen w-full relative flex text-white flex-col items-center justify-center overflow-hidden">
			<HeroStars client:load />
			<div data-hero-sky-mask class="w-full max-w-6xl mx-auto px-8 relative z-10">
                <FlightBoard client:load />
            </div>
            <ScrollToStartButton client:load />
		</section>

		{/* A1: About Section */}
		<section id="about" class="w-full relative">
			<AboutSection client:idle />
		</section>

        {/* B2: Journey Section */}
		<section id="journey" class="w-full relative">
			<JourneySection client:idle />
		</section>

        {/* C3: Destinations Section */}
		<section id="destinations" class="w-full relative">
			<DestinationsSection client:idle projects={projects} />
		</section>

        {/* D4: Beyond Code Section */}
		<section id="beyond-code" class="w-full relative">
			<BeyondCodeSection client:idle />
		</section>

        {/* E5: Contact Section */}
		<section id="contact" class="w-full relative">
			<ContactSection client:idle />
		</section>

        {/* F6: Arrivals Section */}
		<section id="arrivals" class="w-full relative">
			<ArrivalsSection client:idle />
		</section>
		</main>
</MainLayout>
