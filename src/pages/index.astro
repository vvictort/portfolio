---
import MainLayout from '../layouts/MainLayout.astro';
import { FlightBoard } from '../components/FlightBoard';
---

<MainLayout title="Flight Board Portfolio">
	<main class="h-screen overflow-y-scroll snap-y snap-mandatory scroll-smooth">
		{/* Flight Board Section */}
		<section class="h-screen w-full snap-start relative flex items-center justify-center bg-black overflow-hidden">
			<FlightBoard client:idle />
		</section>

		{/* Placeholder for Next Section (e.g., Projects) */}
		<section class="h-screen w-full snap-start relative flex items-center justify-center bg-zinc-900 border-t border-white/10">
			<div class="text-center font-sans">
				<h2 class="text-4xl font-bold text-white mb-4">Projects</h2>
				<p class="text-zinc-400">Scroll down to explore.</p>
			</div>
		</section>

		{/* Placeholder for Another Section (e.g., About) */}
		<section class="h-screen w-full snap-start relative flex items-center justify-center bg-black border-t border-white/10">
			<div class="text-center font-sans">
				<h2 class="text-4xl font-bold text-white mb-4">About Me</h2>
				<p class="text-zinc-400">Get to know me better.</p>
			</div>
		</section>
	</main>
</MainLayout>

<style>
	/* Hide scrollbar for Chrome, Safari and Opera */
	main::-webkit-scrollbar {
		display: none;
	}

	/* Hide scrollbar for IE, Edge and Firefox */
	main {
		-ms-overflow-style: none;  /* IE and Edge */
		scrollbar-width: none;  /* Firefox */
	}
</style>
